# Mandate402 environment template
# Keep real values in .env.local, Cloudflare secrets, or CI secrets.

# -----------------------------------------------------------------------------
# App runtime
# -----------------------------------------------------------------------------
APP_ENV=production
MANDATE402_PERSISTENCE_MODE=postgres

# -----------------------------------------------------------------------------
# Database
# -----------------------------------------------------------------------------
MANDATE402_DATABASE_URL=postgres://user:password@host:5432/mandate402
MANDATE402_DATABASE_DIRECT_URL=postgres://user:password@host:5432/mandate402
MANDATE402_DB_POOL_MAX=10
MANDATE402_DB_IDLE_TIMEOUT_MS=10000

# -----------------------------------------------------------------------------
# Operator auth: Supabase
# -----------------------------------------------------------------------------
NEXT_PUBLIC_SUPABASE_URL=https://your-project.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=replace-me

# -----------------------------------------------------------------------------
# Internal worker auth
# -----------------------------------------------------------------------------
MANDATE402_WORKER_TOKEN=replace-me
MANDATE402_CONTROL_API_URL=https://your-app.example.com

# -----------------------------------------------------------------------------
# Morph runtime: simple EOA signer model
# -----------------------------------------------------------------------------
MORPH_RPC_URL=https://rpc-quicknode.morph.network
MORPH_CHAIN_ID=2818
MORPH_EXPLORER_URL=https://explorer.morph.network
MORPH_PRIVATE_KEY=0xreplace_me

# -----------------------------------------------------------------------------
# Morph contracts
# -----------------------------------------------------------------------------
MANDATE_REGISTRY_ADDRESS=0xreplace_me
MANDATE402_TREASURY_ADDRESS=0xreplace_me
MANDATE402_TREASURY_SETTLEMENT_TOKEN_ADDRESS=0xreplace_me
MANDATE402_TREASURY_SETTLEMENT_TOKEN_DECIMALS=6
MANDATE402_TREASURY_FACILITATOR_ADDRESS=0xreplace_me
MANDATE402_AGENT_ONCHAIN_ADDRESS_AGENT_RESEARCH_ALPHA=0xreplace_me

# -----------------------------------------------------------------------------
# x402 vendor endpoints
# Do not point these at the facilitator. These are paid vendor service URLs.
# -----------------------------------------------------------------------------
PRIMARY_X402_VENDOR_A_URL=http://localhost:8000/x402_demo/api/market-data
PRIMARY_X402_VENDOR_B_URL=http://localhost:8000/x402_demo/api/research
MANDATE402_STATUS_TOKEN=replace-me
MORPH_X402_FACILITATOR_URL=https://morph-rails.morph.network/x402

# -----------------------------------------------------------------------------
# Local Go demo vendor
# -----------------------------------------------------------------------------
MORPH_HOODI_X402_FACILITATOR_URL=https://morph-rails-hoodi.morph.network/x402/v2
MORPH_X402_ACCESS_KEY=replace-me
MORPH_X402_SECRET_KEY=replace-me
MORPH_X402_PAYTO_ADDRESS=0xreplace_me
MORPH_X402_PRICE=0.001
MORPH_X402_VENDOR_PORT=:8000
MORPH_X402_SYNC_FACILITATOR_ON_START=false
MORPH_HOODI_CHAIN_ID=2910
MORPH_HOODI_TOKEN_ADDRESS=0xreplace_me
MORPH_HOODI_TOKEN_NAME=HoodiTestToken
MORPH_HOODI_TOKEN_VERSION=1.0
MORPH_HOODI_TOKEN_DECIMALS=18

# -----------------------------------------------------------------------------
# Treasury deployment inputs
# -----------------------------------------------------------------------------
MANDATE402_DEPLOYER_PRIVATE_KEY=0xreplace_me
MANDATE402_GOVERNANCE_OWNER=0xreplace_me
MANDATE402_PYTH_ORACLE_ADDRESS=0xreplace_me
MANDATE402_PYTH_ETH_USD_FEED_ID=replace-me
MANDATE402_PYTH_USDC_USD_FEED_ID=replace-me

# -----------------------------------------------------------------------------
# Market-data providers behind local demo vendors
# -----------------------------------------------------------------------------
MANDATE402_MARKET_PROVIDER=demo
CMC_BASE_URL=https://pro-api.coinmarketcap.com
CMC_API_KEY=replace-me
COINAPI_BASE_URL=https://rest.coinapi.io
COINAPI_KEY=replace-me

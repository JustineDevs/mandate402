{
  "name": "mandate402",
  "version": "0.1.1",
  "private": true,
  "pnpm": {
    "overrides": {
      "postcss": "8.5.10",
      "uuid": "14.0.0",
      "ws": "8.20.1"
    }
  },
  "scripts": {
    "dev": "pnpm exec next dev",
    "dev:webpack": "pnpm exec next dev --webpack",
    "build": "node scripts/clean-build-artifacts.mjs && node scripts/run-next-build.mjs",
    "cloudflare:build": "node scripts/clean-build-artifacts.mjs && node scripts/run-cloudflare-build.mjs",
    "cloudflare:dry-run": "node scripts/run-cloudflare-pipeline.mjs",
    "start": "pnpm exec next start",
    "lint": "eslint src e2e playwright.config.ts next.config.ts eslint.config.mjs vitest.config.ts",
    "typecheck": "tsc --noEmit",
    "test": "node scripts/run-vitest.mjs",
    "test:e2e": "playwright test",
    "proof:live": "node scripts/run-production-proof.mjs",
    "db:generate": "drizzle-kit generate",
    "db:migrate": "drizzle-kit migrate",
    "db:studio": "drizzle-kit studio",
    "workers:dry-run": "env XDG_CONFIG_HOME=.tmp/wrangler-config HOME=.tmp/wrangler-home pnpm exec wrangler deploy --config wrangler.worker.toml --dry-run --outdir .tmp/wrangler-dry-run",
    "format": "biome format --write . --files-ignore-unknown=true",
    "check:biome": "biome check . --files-ignore-unknown=true",
    "check:repo-safety": "node scripts/check-repo-safety.mjs",
    "check:release-readiness": "node scripts/check-release-readiness.mjs",
    "ci:all": "node scripts/clean-build-artifacts.mjs && node scripts/check-repo-safety.mjs && biome check . --files-ignore-unknown=true && node scripts/run-vitest.mjs && tsc --noEmit && eslint src e2e playwright.config.ts next.config.ts eslint.config.mjs vitest.config.ts",
    "changeset": "changeset",
    "release:dry-run": "semantic-release --dry-run --no-ci",
    "release": "semantic-release",
    "prepare": "lefthook install || true"
  },
  "dependencies": {
    "@base-ui/react": "^1.5.0",
    "@biconomy/abstractjs": "^1.2.4",
    "@farcaster/mini-app-solana": "^1.1.3",
    "@opennextjs/cloudflare": "^1.19.11",
    "@privy-io/react-auth": "^3.27.1",
    "@supabase/supabase-js": "^2.105.4",
    "@vercel/analytics": "^2.0.1",
    "@x402/core": "^2.12.0",
    "@x402/evm": "^2.12.0",
    "@x402/fetch": "^2.12.0",
    "abitype": "^1.2.3",
    "class-variance-authority": "^0.7.1",
    "clsx": "^2.1.1",
    "drizzle-orm": "^0.44.5",
    "jose": "^5.10.0",
    "lucide-react": "^0.468.0",
    "next": "^16.2.6",
    "pg": "^8.20.0",
    "pg-cloudflare": "^1.3.0",
    "react": "^19.0.0",
    "react-dom": "^19.0.0",
    "shadcn": "^4.8.0",
    "tailwind-merge": "^3.6.0",
    "tw-animate-css": "^1.4.0",
    "viem": "^2.30.0",
    "webauthn-p256": "^0.0.5",
    "zod": "^3.24.4"
  },
  "devDependencies": {
    "@biomejs/biome": "^1.9.4",
    "@changesets/changelog-github": "^0.5.1",
    "@changesets/cli": "^2.29.6",
    "@next/eslint-plugin-next": "^15.3.2",
    "@playwright/test": "^1.60.0",
    "@semantic-release/changelog": "^6.0.3",
    "@semantic-release/commit-analyzer": "^13.0.1",
    "@semantic-release/git": "^10.0.1",
    "@semantic-release/github": "^11.0.1",
    "@semantic-release/release-notes-generator": "^14.1.0",
    "@tailwindcss/postcss": "^4.3.0",
    "@types/node": "^22.15.21",
    "@types/pg": "^8.20.0",
    "@types/react": "^19.0.8",
    "@types/react-dom": "^19.0.3",
    "@typescript-eslint/eslint-plugin": "^8.32.1",
    "@typescript-eslint/parser": "^8.32.1",
    "autoprefixer": "^10.5.0",
    "drizzle-kit": "^0.31.5",
    "eslint": "^9.26.0",
    "lefthook": "^1.7.21",
    "lightningcss-win32-x64-msvc": "1.32.0",
    "postcss": "^8.5.14",
    "semantic-release": "^24.2.7",
    "tailwindcss": "^4.3.0",
    "typescript": "5.9.3",
    "vitest": "^3.1.3",
    "wrangler": "^4.94.0"
  }
}

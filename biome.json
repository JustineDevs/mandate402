{
  "$schema": "https://biomejs.dev/schemas/1.9.4/schema.json",
  "formatter": {
    "enabled": true,
    "indentStyle": "space",
    "indentWidth": 2
  },
  "linter": {
    "enabled": true,
    "rules": {
      "recommended": true
    }
  },
  "files": {
    "ignore": [
      ".agents",
      ".omx",
      ".next",
      ".open-next",
      "node_modules",
      "contracts/out",
      "contracts/cache",
      "contracts/broadcast",
      ".tmp",
      "output/playwright",
      "data/store.json",
      ".env.local",
      ".agents"
    ]
  },
  "overrides": [
    {
      "include": ["src/components/ui/label.tsx"],
      "linter": {
        "rules": {
          "a11y": {
            "noLabelWithoutControl": "off"
          }
        }
      }
    }
  ]
}
